# EVA V2 foundation settings (all use the EVA_ prefix)
EVA_ENVIRONMENT=development
EVA_DEBUG=False
EVA_DOCS_ENABLED=True
EVA_API_V1_PREFIX=/api/v1
EVA_LOG_LEVEL=INFO
EVA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
EVA_SECRET_KEY=replace-with-a-long-random-value
EVA_LEGACY_APP_ENABLED=False
EVA_DATABASE_URL=postgresql+asyncpg://eva:eva@localhost:5432/eva
EVA_DATABASE_ECHO=False
EVA_EMBEDDING_DIMENSIONS=768
EVA_LEGACY_MYSQL_HOST=localhost
EVA_LEGACY_MYSQL_PORT=3306
EVA_LEGACY_MYSQL_USER=root
EVA_LEGACY_MYSQL_PASSWORD=
